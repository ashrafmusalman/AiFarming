<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/signup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="20dp"
    android:background="@color/bg_light">

    <LinearLayout
        android:id="@+id/signup_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp">

        <!-- LOGO -->
        <ImageView
            android:id="@+id/imageView3"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginTop="36dp"
            android:src="@drawable/logo"
            android:scaleType="centerCrop" />

        <!-- APP NAME -->
        <TextView
            android:id="@+id/textTitleApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/farming_app"
            android:textSize="30sp"
            android:textColor="@color/brand_green"
            android:fontFamily="@font/berkshire_swash" />

        <!-- SUBTITLE -->
        <TextView
            android:id="@+id/textSubtitleApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/get_your_farming_product_here"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/brand_green_dark"
            android:fontFamily="@font/architects_daughter" />

        <!-- SIGN UP TITLE -->
        <TextView
            android:id="@+id/textSignupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/sign_up_here"
            android:textSize="22sp"
            android:textColor="@color/brand_green"
            android:textStyle="bold" />

        <!-- NAME FIELD -->
        <EditText
            android:id="@+id/Name"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/edittext_modern"
            android:backgroundTint="@null"
            android:hint="@string/first_name"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textPersonName"
            android:maxLines="1" />

        <!-- EMAIL FIELD -->
        <EditText
            android:id="@+id/Emailorphone"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="14dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/edittext_modern"
            android:backgroundTint="@null"
            android:hint="@string/enter_email"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textEmailAddress"
            android:imeOptions="actionNext"
            android:maxLines="1"
            android:autofillHints="emailAddress" />

        <!-- PASSWORD FIELD -->
        <EditText
            android:id="@+id/Loginpassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="14dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/edittext_modern"
            android:backgroundTint="@null"
            android:hint="@string/enter_the_password"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textPassword"
            android:imeOptions="actionNext"
            android:maxLines="1"
            android:autofillHints="password" />

        <!-- CONFIRM PASSWORD FIELD -->
        <EditText
            android:id="@+id/cnfpassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="14dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/edittext_modern"
            android:backgroundTint="@null"
            android:hint="@string/confirm_password"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textPassword"
            android:imeOptions="actionDone"
            android:maxLines="1"
            android:autofillHints="password" />

        <!-- SIGN UP BUTTON -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/buttonshape0"
            android:text="@string/create_account"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textColor="@color/green"
            android:stateListAnimator="@null" />

        <!-- ALREADY HAVE ACCOUNT -->
        <TextView
            android:id="@+id/alreadyHaveAccount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/already_have_an_account"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/green" />

        <!-- PROGRESS BAR -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
