<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_screen_graph"
    app:startDestination="@id/HomeFragment">

    <fragment
        android:id="@+id/HomeFragment"
        android:name="com.ashraf.farming.mainscreen.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_articleDetailsFragment"
            app:destination="@id/articleDetailsFragment" />

        <action
            android:id="@+id/action_homeFragment_to_chatFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:destination="@id/chatFragment" />
    </fragment>
    <fragment
        android:id="@+id/PostFragment"
        android:name="com.ashraf.farming.mainscreen.PostFragment"
        android:label="fragment_post"
        tools:layout="@layout/fragment_post">
        <action
            android:id="@+id/action_postFragment2_to_addPostFragment"
            app:destination="@id/addPostFragment" />
    </fragment>
    <fragment
        android:id="@+id/addPostFragment"
        android:name="com.ashraf.farming.mainscreen.AddPostFragment"
        android:label="fragment_add_post"
        tools:layout="@layout/fragment_add_post">
        <action
            android:id="@+id/action_addPostFragment_to_postFragment2"
            app:destination="@id/PostFragment" />
    </fragment>
    <fragment
        android:id="@+id/weatherFragment"
        android:name="com.ashraf.farming.weather.fragment.WeatherFragment"
        android:label="fragment_weather"
        tools:layout="@layout/fragment_weather" />
    <fragment
        android:id="@+id/EcommerceFragment"
        android:name="com.ashraf.farming.mainscreen.EcommerceFragment"
        android:label="fragment_ecommerce"
        tools:layout="@layout/fragment_ecommerce">
        <action
            android:id="@+id/action_ecommerceFragment_to_productDetailFragment"
            app:destination="@id/productDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/addProductFragment"
        android:name="com.ashraf.farming.mainscreen.AddProductFragment"
        android:label="fragment_add_product"
        tools:layout="@layout/fragment_add_product">
        <argument
            android:name="productUpdate"
            app:argType="com.ashraf.farming.datamodel.Product"
            app:nullable="true" />
    </fragment>
    <fragment
        android:id="@+id/yourProductFragment"
        android:name="com.ashraf.farming.mainscreen.YourProductFragment"
        android:label="fragment_your_product"
        tools:layout="@layout/fragment_your_product">
        <action
            android:id="@+id/action_yourProductFragment_to_productDetailFragment"
            app:destination="@id/productDetailFragment" />
        <action
            android:id="@+id/action_yourProductFragment_to_addProductFragment"
            app:destination="@id/addProductFragment" />
    </fragment>
    <fragment
        android:id="@+id/productDetailFragment"
        android:name="com.ashraf.farming.mainscreen.ProductDetailFragment"
        android:label="fragment_product_detail"
        tools:layout="@layout/fragment_product_detail">
        <action
            android:id="@+id/action_productDetailFragment_to_yourProductFragment"
            app:destination="@id/yourProductFragment" />
        <action
            android:id="@+id/action_productDetailFragment_to_ecommerceFragment"
            app:destination="@id/EcommerceFragment" />
        <argument
            android:name="product"
            app:argType="com.ashraf.farming.datamodel.Product" />
        <argument
            android:name="source"
            app:argType="string"
            app:nullable="true" />
    </fragment>
    <fragment
        android:id="@+id/cartFragment"
        android:name="com.ashraf.farming.mainscreen.CartFragment"
        android:label="fragment_cart"
        tools:layout="@layout/fragment_cart" >
        <action
            android:id="@+id/action_cartFragment_to_billingFragment"
            app:destination="@id/billingFragment" />
    </fragment>
    <fragment
        android:id="@+id/billingFragment"
        android:name="com.ashraf.farming.mainscreen.BillingFragment"
        android:label="fragment_billing"
        tools:layout="@layout/fragment_billing" >
        <action
            android:id="@+id/action_billingFragment_to_addressFragment"
            app:destination="@id/addressFragment" />
        <argument
            android:name="cartItem"
            app:argType="com.ashraf.farming.datamodel.CartItem" />
        <action
            android:id="@+id/action_billingFragment_to_thanksFragment"
            app:destination="@id/thanksFragment" />
    </fragment>
    <fragment
        android:id="@+id/addressFragment"
        android:name="com.ashraf.farming.mainscreen.AddressFragment"
        android:label="fragment_address"
        tools:layout="@layout/fragment_address" >
        <action
            android:id="@+id/action_addressFragment_to_billingFragment"
            app:destination="@id/billingFragment" />
    </fragment>
    <fragment
        android:id="@+id/thanksFragment"
        android:name="com.ashraf.farming.mainscreen.ThanksFragment"
        android:label="fragment_thanks"
        tools:layout="@layout/fragment_thanks" />
    <fragment
        android:id="@+id/orderedFragment"
        android:name="com.ashraf.farming.mainscreen.OrderedFragment"
        android:label="fragment_ordered"
        tools:layout="@layout/fragment_ordered" />
    <fragment
        android:id="@+id/orderReceivedFragment"
        android:name="com.ashraf.farming.mainscreen.OrderReceivedFragment"
        android:label="fragment_order_received"
        tools:layout="@layout/fragment_order_received" />
    <fragment
        android:id="@+id/APMCFragment"
        android:name="com.ashraf.farming.mainscreen.ampc.APMCFragment"
        android:label="APMCFragment" />
    <fragment
        android:id="@+id/articleDetailsFragment"
        android:name="com.ashraf.farming.mainscreen.article.ArticleDetailsFragment"
        android:label="fragment_article_details"
        tools:layout="@layout/fragment_article_details" >
        <action
            android:id="@+id/action_articleDetailsFragment_to_specificElementDetailsFragment"
            app:destination="@id/specificElementDetailsFragment" />
        <argument
            android:name="plant"
            app:argType="com.ashraf.farming.datamodel.homeak.Data" />
    </fragment>
    <fragment
        android:id="@+id/specificElementDetailsFragment"
        android:name="com.ashraf.farming.mainscreen.article.SpecificElementDetailsFragment"
        android:label="fragment_specific_element_details"
        tools:layout="@layout/fragment_specific_element_details" >
        <argument
            android:name="articleData"
            app:nullable="true"
            app:argType="com.ashraf.farming.datamodel.article.Data" />
    </fragment>
<!--    <fragment-->
<!--        android:id="@+id/healthPredectionFragment"-->
<!--        android:name="com.shahbaz.farming.mainscreen.HealthPredectionFragment"-->
<!--        android:label="fragment_health_predection"-->
<!--        tools:layout="@layout/fragment_health_predection" />-->
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.ashraf.farming.mainscreen.ProfileFragment"
        android:label="fragment_profile"
        tools:layout="@layout/fragment_profile" />
    <fragment
        android:id="@+id/FAQFragment"
        android:name="com.ashraf.farming.mainscreen.FAQFragment"
        android:label="fragment_f_a_q"
        tools:layout="@layout/fragment_f_a_q" />
    <fragment
        android:id="@+id/chatFragment"
        android:name="com.ashraf.farming.mainscreen.ChatFragment"
        android:label="fragment_chat"
        tools:layout="@layout/fragment_chat" />
    <fragment
        android:id="@+id/loginFragment2"
        tools:layout="@layout/fragment_login"
        android:name="com.ashraf.farming.authentication.LoginFragment"
        android:label="LoginFragment" />
    <fragment
        android:id="@+id/signUpFragment2"
        tools:layout="@layout/fragment_sign_up"
        android:name="com.ashraf.farming.authentication.SignUpFragment"
        android:label="SignUpFragment" />
</navigation>